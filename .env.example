# Copy to .env.local and fill in what you use. Every value may stay empty: the site then runs on
# Base in preview mode, with each feature below turned off. Titles, descriptions and other copy
# are not here: they live in src/config/site.js

# ---- Site ----

# Public site origin: canonical links, share cards, the sitemap and the NFT data link
# (<origin>/nft/). Empty is http://localhost:3005
NEXT_PUBLIC_BASE_URL=

# The gateway ipfs:// photos are shown from. Empty uses Filebase's public gateway; a dedicated one
# looks like https://<name>.myfilebase.com/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY_URL_PRIMARY=

# ---- Registry ----

# The chain the registry lives on: 8453 (Base, the default) or 84532 (Base Sepolia, for rehearsal)
NEXT_PUBLIC_READABLE_CHAIN_ID=

# RPC override for that chain. Falls back to the chain's public endpoint
NEXT_PUBLIC_READABLE_RPC=

# Deployed Readable registry on that chain. Empty keeps the site in preview mode with launch prices
NEXT_PUBLIC_READABLE_ADDRESS=

# ---- Wallets ----

# WalletConnect (Reown) project id. Empty leaves WalletConnect out, and with it every phone wallet
# that is not the browser the site is opened in. Allow the site origin in the Reown dashboard
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Server-only: never NEXT_PUBLIC, never committed ----

# Gasless name changes (target, records, addresses, primary name, as config/gasless.js lists).
# The key of the wallet that pays their network fee; keep a little ETH on it. Buying is never
# relayed. Empty turns gasless off: holders send their changes as ordinary transactions
RELAYER_PRIVATE_KEY=

# RPC the relayer sends through. Falls back to NEXT_PUBLIC_READABLE_RPC, then the public endpoint
RELAYER_RPC=

# The paymaster that pays a smart wallet's fee for a change to a name (ERC-7677), e.g. Coinbase
# Developer Platform's. The site passes changes to a name only; allow only the registry in the
# paymaster's dashboard too. Empty: smart wallets pay their own fee
PAYMASTER_URL=

# Photo uploads for a name's records, pinned on IPFS through Filebase as on Hup (same variable).
# Empty turns uploads off: the holder pastes a photo link instead
FILEBASE_IPFS_RPC_TOKEN=
# Filebase's IPFS RPC. Empty is https://rpc.filebase.io/api/v0/add; set only to test against a stand-in
FILEBASE_IPFS_RPC_URL=

# The ENS gateway (/api/ens): lets every wallet that reads ENS resolve 4242.<parent> to a Readable
# name. The key signs answers; the resolver contract on Ethereum trusts its address.
# Empty turns the gateway off
ENS_GATEWAY_PRIVATE_KEY=
# The ENS name Readable's names live under (empty is readable.eth), and the resolver contract
# that may ask
ENS_PARENT_NAME=
ENS_RESOLVER_ADDRESS=

# Buying ETH by card, through Coinbase's onramp (Base only, no testnet). A CDP secret API key; an
# EC key may carry its line breaks as \n. Empty hides the link
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
